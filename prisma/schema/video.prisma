model Video {
  id            String        @id @default(cuid())
  title         String
  description   String?
  tags          String[]
  streamtapeId  String        @unique
  fileName      String
  streamtapeUrl String
  embedUrl      String
  thumbnailUrl  String?
  downloadUrl   String?
  folderId      String?
  size          BigInt?
  status        VideoStatus   @default(PROCESSING)
  visibility    VideoVisibility @default(UNLISTED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([visibility])
}

enum VideoStatus {
  PROCESSING
  READY
  FAILED
}

enum VideoVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}
