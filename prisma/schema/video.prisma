model Video {
  id            String        @id @default(cuid())
  title         String
  description   String?
  tags          String[]
  streamtapeId  String        @unique
  fileName      String
  streamtapeUrl String
  embedUrl      String
  thumbnailUrl  String?
  downloadUrl   String?
  folderId      String?
  size          BigInt?
  status        VideoStatus   @default(PROCESSING)
  visibility    VideoVisibility @default(UNLISTED)
  views         Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewEvents    VideoView[]

  @@index([userId])
  @@index([visibility])
  @@index([visibility, createdAt])
  @@index([visibility, views])
}

model VideoView {
  id          String   @id @default(cuid())
  videoId     String
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  visitorHash String
  bucket      String
  createdAt   DateTime @default(now())

  @@unique([videoId, visitorHash, bucket])
  @@index([createdAt])
}

enum VideoStatus {
  PROCESSING
  READY
  FAILED
}

enum VideoVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}
